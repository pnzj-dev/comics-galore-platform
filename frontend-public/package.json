{
	"name": "frontend-public",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "bun run build/index.js",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test:unit:watch": "vitest --watch",
		"test:e2e": "playwright test",
		"test": "bun run test:unit --run && bun run test:e2e"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.33.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/svelte-table": "^9.0.0",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/zxcvbn": "^4.4.5",
		"bits-ui": "^2.16.3",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-cryptocurrency-icons": "^1.0.4",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"fflate": "^0.8.3",
		"lucide-svelte": "^1.0.1",
		"sveltekit-sse": "^0.15.1",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3",
		"zxcvbn": "^4.4.2"
	}
}
