# Frontend configuration — Comics Galore (public)
# Copy to .env for local development. Never commit real secrets.

# Base URL of the Encore backend (used for OAuth redirects and media).
VITE_BACKEND_URL=http://localhost:4000

# Base URL of the Encore API (legacy media paths).
VITE_API_URL=http://localhost:4000

# Cloudflare Turnstile sitekey (public). Leave empty to disable the widget.
VITE_TURNSTILE_SITEKEY=
