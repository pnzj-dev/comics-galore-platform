# Frontend configuration — Comics Galore (admin)
# Copy to .env for local development. Never commit real secrets.

# Base URL of the Encore backend.
VITE_BACKEND_URL=http://localhost:4000

# Cloudflare Turnstile sitekey (admin login bot protection). Leave unset to disable.
VITE_TURNSTILE_SITEKEY=

# Environment tag: dev | staging | prod (or leave unset). Drives the header
# environment badge, favicon dot, console warning and noindex on non-prod.
VITE_ENV=

# Logto (authentication) — required. See docs/authentication.md.
LOGTO_ENDPOINT=https://<tenant>.logto.app/
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_COOKIE_ENCRYPTION_KEY=
