#!/bin/sh

echo ""
echo "┌─────────────────────────────┐"
echo "│  Running backend checks...   │"
echo "└─────────────────────────────┘"

cd backend && go build ./... 2>&1 | tail -5
if [ ${PIPESTATUS[0]} -ne 0 ]; then
  echo ""
  echo "Backend build failed. Push aborted."
  exit 1
fi

echo ""
echo "┌─────────────────────────────┐"
echo "│  Running frontend tests...   │"
echo "└─────────────────────────────┘"

cd ../frontend-public && bun run test:unit --run 2>&1 | tail -3
if [ ${PIPESTATUS[0]} -ne 0 ]; then
  echo ""
  echo "Frontend tests failed. Push aborted."
  exit 1
fi

echo ""
echo "All checks passed. Pushing..."
